rules_version = '2';
// No sign-in by design: anyone with the app link can read and write. Keep the Vercel URL private.
// Writes are shape-checked so a bad client can't store junk that breaks the order math.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.orderStep is number && request.resource.data.orderStep >= 1;
    }
    match /salesWeeks/{weekStart} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.weekStart == weekStart && request.resource.data.rows is list;
    }
    match /counts/{date} {
      allow read: if true;
      allow create, update: if request.resource.data.date == date && request.resource.data.entries is map;
    }
    match /orders/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.id == id && request.resource.data.lines is map;
    }
    match /scheduleChanges/{date} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.date == date && request.resource.data.delivery is bool;
    }
    match /holidaySettings/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.id == id && request.resource.data.days is map;
    }
    match /events/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.id == id && request.resource.data.name is string
        && request.resource.data.start is string && request.resource.data.end is string;
    }
  }
}
