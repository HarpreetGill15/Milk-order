# Firebase web app config (safe to expose in the client — access is controlled by Firestore
# security rules). Firebase Console > Project settings > General > Your apps > Web app > Config.
# Leave blank to run with browser-only storage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
